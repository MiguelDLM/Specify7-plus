{
  "manifest_version": 3,
  "name": "Specify7+",
  "version": "2.1.0",
  "description": "Specify7+ — import bibliography and view 3D models inside Specify 7",
  "permissions": [
    "activeTab",
    "clipboardRead",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/utils/bibtex-parser.js",
        "src/content/namespace.js",
        "src/content/helpers.js",
        "src/content/matcher.js",
        "src/content/form-utils.js",
        "src/content/bibtex-doi.js",
        "src/content/json-importer.js",
        "src/content/model-viewer.js",
        "src/content/query-tools.js",
        "src/content/main.js"
      ],
      "css": ["src/content/content-styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/viewer/viewer.html", 
        "src/viewer/viewer.js", 
        "src/viewer/viewer.css",
        "src/viewer/importmap.json",
        "lib/three/three.min.js",
        "lib/three/three.module.js",
        "lib/three/STLLoader.js",
        "lib/three/OrbitControls.js",
        "lib/three/OBJLoader.js",
        "lib/three/PLYLoader.js",
        "lib/three/jsm/STLLoader.js",
        "lib/three/jsm/OBJLoader.js",
        "lib/three/jsm/PLYLoader.js",
        "lib/three/jsm/OrbitControls.js",
        "lib/three/jsm/TrackballControls.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
